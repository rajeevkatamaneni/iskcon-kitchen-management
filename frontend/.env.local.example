# Firebase web configuration.
#
# These are NOT secrets. Firebase web config values are designed to be public and ship in
# browser JavaScript — anyone can read them from any Firebase-backed site. Security comes from
# Firebase's own auth rules and from the backend verifying every token against Google's public
# keys. They live in environment variables so the values can differ between staging and
# production, not to hide them.
#
# Copy to .env.local for local development.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCE3ZhZQnncECDaieQCu0wp2DP-Biosf5I
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=iskcon-kms-2026-620ee.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=iskcon-kms-2026-620ee
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=iskcon-kms-2026-620ee.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=970623926730
NEXT_PUBLIC_FIREBASE_APP_ID=1:970623926730:web:db50c68f75ad9d5de58f33

# Backend API. Empty means same origin.
NEXT_PUBLIC_API_URL=http://localhost:8080
