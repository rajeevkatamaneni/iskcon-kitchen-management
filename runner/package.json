{
  "name": "kms-assistant-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Runs one locked-down `claude -p` per request and streams its stream-json back (E10-T9).",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.289"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "typescript": "5.6.3"
  }
}
